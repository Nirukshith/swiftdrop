{
  "request": {
    "method": "GET",
    "urlPath": "/internal/v1/pricing/quote",
    "queryParameters": {
      "pickupDistrict": {
        "matches": ".+"
      },
      "dropoffDistrict": {
        "matches": ".+"
      },
      "weightKg": {
        "matches": "[0-9]+(\\.[0-9]+)?"
      },
      "size": {
        "matches": ".+"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "currency": "LKR",
      "totalFee": 850.0,
      "breakdown": {
        "dropoffZoneBaseFee": 500.0,
        "weightBandCharge": 200.0,
        "sizeCharge": 150.0
      },
      "pickupZone": "COLOMBO",
      "dropoffZone": "GAMPAHA"
    }
  }
}
