# PostgreSQL Configuration
POSTGRES_USER=swiftdrop
POSTGRES_PASSWORD=swiftdrop_password
POSTGRES_PORT=5434
FRONTEND_PORT=4200

# External Integrations
LLM_API_KEY=placeholder-llm-api-key
# Fill these from a Google Cloud OAuth 2.0 Web application client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Docker Compose gateway callback. For `ng serve` + direct auth-service, use port 8081.
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth2/callback/google
GOOGLE_FRONTEND_CALLBACK_URL=http://localhost:4200/auth/callback
